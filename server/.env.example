# Variables du service (à définir dans Coolify, jamais dans le dépôt).

# PocketBase, par son domaine (le nom des conteneurs change avec Coolify).
PB_URL=https://db.cahors.kappuccino.net
# Superutilisateur PocketBase réservé au service : jeton fixe (MFA activé sur les superutilisateurs),
# créé dans l'interface PocketBase : _superusers → compte du service → Impersonate (durée longue).
PB_ADMIN_TOKEN=
# … ou email + mot de passe (seulement si les superutilisateurs n'ont pas de MFA).
# PB_ADMIN_EMAIL=
# PB_ADMIN_PASSWORD=

# Clé privée Ed25519 des tickets (créée par « npm run keygen ») : fichier monté…
LICENCE_PRIVATE_KEY_FILE=/run/secrets/licence.pem
# … ou contenu PEM directement (retours à la ligne en \n).
# LICENCE_PRIVATE_KEY=

# Jeton de la CI pour déposer les versions (long et aléatoire, aussi dans les secrets GitHub).
RELEASE_UPLOAD_TOKEN=

# Facultatif
# PORT=3000
# DATA_DIR=/data
# LICENCE_DAYS=15
# DEFAULT_MAX_DEVICES=2
